;;; etaf-desktop-spacing-tests.el --- Public tile spacing scenarios -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'etaf-desktop)
(require 'etaf)

(defun etaf-desktop-test-spacing-rectangle (desktop id)
  "Return ID's public rectangle in DESKTOP."
  (let ((window (etaf-desktop-window-state desktop id)))
    (mapcar (lambda (key) (plist-get window key)) '(:x :y :width :height))))

(defun etaf-desktop-test-spacing-press (runtime label)
  "Press the rendered control with accessible LABEL in RUNTIME."
  (let ((entry (cl-find-if
                (lambda (item) (equal label (plist-get (cdr item) :aria-label)))
                (etaf-runtime-host-props-entries runtime))))
    (should entry)
    (should (etaf-host-ref-position runtime (car entry)))
    (etaf-dispatch-event runtime (car entry) 'press)))

(ert-deftest etaf-desktop-tile-spacing-defaults-and-reset ()
  "New controllers and reset settings use detached one-cell gap preferences."
  (let* ((cell (frame-char-width))
         (desktop (etaf-desktop-create :canvas-width (* 100 cell)
                                       :canvas-height 24)))
    (unwind-protect
        (progn
          (let ((settings (etaf-desktop-settings desktop)))
            (should (= 1 (plist-get settings :tile-outer-gap)))
            (should (= 1 (plist-get settings :tile-inner-gap)))
            (setf (plist-get settings :tile-outer-gap) 4)
            (setf (plist-get settings :tile-inner-gap) 4)
            (should (= 1 (plist-get (etaf-desktop-settings desktop)
                                    :tile-outer-gap)))
            (should (= 1 (plist-get (etaf-desktop-settings desktop)
                                    :tile-inner-gap))))
          (etaf-desktop-open-window desktop 'one :min-width 5 :min-height 2)
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (should (equal (list cell 1 (* 98 cell) 22)
                         (etaf-desktop-test-spacing-rectangle desktop 'one)))
          (etaf-desktop-set-setting desktop :tile-outer-gap 0)
          (etaf-desktop-set-setting desktop :tile-inner-gap 4)
          (let ((settings (etaf-desktop-reset-settings desktop)))
            (should (= 1 (plist-get settings :tile-outer-gap)))
            (should (= 1 (plist-get settings :tile-inner-gap))))
          (should (eq 'floating (etaf-desktop-layout-mode desktop)))
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (should (equal (list cell 1 (* 98 cell) 22)
                         (etaf-desktop-test-spacing-rectangle desktop 'one))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-custom-gaps ()
  "Configured cells leave exact outer margins and nested inner gaps."
  (dolist (gaps '((0 1) (2 3) (4 4)))
    (let* ((outer (car gaps))
           (inner (cadr gaps))
           (cell (frame-char-width))
           (width (* 100 cell))
           (desktop (etaf-desktop-create :canvas-width width :canvas-height 32)))
      (unwind-protect
          (progn
            (etaf-desktop-set-setting desktop :tile-outer-gap outer)
            (etaf-desktop-set-setting desktop :tile-inner-gap inner)
            (dolist (id '(one two three))
              (etaf-desktop-open-window desktop id :min-width 5 :min-height 2))
            (etaf-desktop-set-layout-mode desktop 'tiling)
            (etaf-desktop-layout-set-tree
             desktop '(:split horizontal 0.5 (:leaf one)
                              (:split vertical 0.5 (:leaf two) (:leaf three))))
            (let ((one (etaf-desktop-window-state desktop 'one))
                  (two (etaf-desktop-window-state desktop 'two))
                  (three (etaf-desktop-window-state desktop 'three)))
              (should (= (* outer cell) (plist-get one :x)))
              (should (= outer (plist-get one :y) (plist-get two :y)))
              (should (= (- width (* outer cell))
                         (+ (plist-get two :x) (plist-get two :width))
                         (+ (plist-get three :x) (plist-get three :width))))
              (should (= (- 32 outer)
                         (+ (plist-get one :y) (plist-get one :height))
                         (+ (plist-get three :y) (plist-get three :height))))
              (should (= (max 3 (* inner cell))
                         (- (plist-get two :x)
                            (+ (plist-get one :x) (plist-get one :width)))))
              (should (= inner (- (plist-get three :y)
                                   (+ (plist-get two :y) (plist-get two :height)))))
              (should (= (plist-get two :x) (plist-get three :x)))
              (should (<= (abs (- (plist-get one :width)
                                 (plist-get two :width))) 1))
              (should (<= (abs (- (plist-get two :height)
                                 (plist-get three :height))) 1))))
        (etaf-desktop-close desktop)))))

(ert-deftest etaf-desktop-tile-spacing-reflows-active-workspace ()
  "Setting gaps reflows active tiles immediately and preserves floating windows."
  (let* ((cell (frame-char-width))
         (desktop (etaf-desktop-create :canvas-width (* 100 cell)
                                       :canvas-height 24)))
    (unwind-protect
        (progn
          (dolist (id '(one two overlay))
            (etaf-desktop-open-window desktop id :min-width 5 :min-height 2))
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (etaf-desktop-layout-set-tree
           desktop '(:split vertical 0.5 (:leaf one) (:leaf two)))
          (etaf-desktop-move-window desktop 'overlay 7 3)
          (etaf-desktop-focus-window desktop 'two)
          (let ((tree (etaf-desktop-layout-tree desktop))
                (floating (etaf-desktop-test-spacing-rectangle desktop 'overlay)))
            ;; No refresh or apply call intervenes between settings and reads.
            (etaf-desktop-set-setting desktop :tile-outer-gap 3)
            ;; 17 available rows split at 0.5 round the half row up to `one'.
            (should (equal (list (* 3 cell) 3 (* 94 cell) 9)
                           (etaf-desktop-test-spacing-rectangle desktop 'one)))
            (should (equal (list (* 3 cell) 13 (* 94 cell) 8)
                           (etaf-desktop-test-spacing-rectangle desktop 'two)))
            (etaf-desktop-set-setting desktop :tile-inner-gap 4)
            (should (equal (list (* 3 cell) 3 (* 94 cell) 7)
                           (etaf-desktop-test-spacing-rectangle desktop 'one)))
            (should (equal (list (* 3 cell) 14 (* 94 cell) 7)
                           (etaf-desktop-test-spacing-rectangle desktop 'two)))
            (should (equal tree (etaf-desktop-layout-tree desktop)))
            (should (eq 'two (etaf-desktop-active-window desktop)))
            (should (equal '(overlay) (etaf-desktop-layout-floating-windows desktop)))
            (should (equal floating
                           (etaf-desktop-test-spacing-rectangle desktop 'overlay)))
            (etaf-desktop-set-layout-mode desktop 'floating)
            (let ((before (etaf-desktop-windows desktop)))
              (etaf-desktop-set-setting desktop :tile-outer-gap 0)
              (etaf-desktop-set-setting desktop :tile-inner-gap 2)
              (should (equal before (etaf-desktop-windows desktop))))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-validates-without-mutation ()
  "Gap settings accept their integer ranges and reject invalid values atomically."
  (let ((desktop (etaf-desktop-create :canvas-width 200 :canvas-height 32)))
    (unwind-protect
        (progn
          (dolist (id '(one two))
            (etaf-desktop-open-window desktop id :min-width 5 :min-height 2))
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (dolist (key '(:tile-outer-gap :tile-inner-gap))
            (dolist (value (if (eq key :tile-outer-gap) '(0 1 2 3 4) '(1 2 3 4)))
              (should (= value (plist-get (etaf-desktop-set-setting desktop key value)
                                          key))))
            (dolist (value (append '(-1 5 1.5 1.0 "2" nil t (2))
                                  (when (eq key :tile-inner-gap) '(0))))
              (let ((settings (etaf-desktop-settings desktop))
                    (state (etaf-desktop-state desktop))
                    (tree (etaf-desktop-layout-tree desktop)))
                (should-error (etaf-desktop-set-setting desktop key value)
                              :type 'etaf-desktop-error)
                (should (equal settings (etaf-desktop-settings desktop)))
                (should (equal state (etaf-desktop-state desktop)))
                (should (equal tree (etaf-desktop-layout-tree desktop)))))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-outer-gaps-yield-to-minimums ()
  "Outer margins shrink on each axis before a tile loses its minimum size."
  (dolist (orientation '(horizontal vertical))
    (dolist (slack '(0 2))
      (let* ((minimum-width (* 6 (frame-char-width)))
             (inner-width (max 3 (* 4 (frame-char-width))))
             (width (+ slack (if (eq orientation 'horizontal)
                                 (+ (* 2 minimum-width) inner-width)
                               minimum-width)))
             (height (+ slack (if (eq orientation 'vertical) 20 8)))
             (desktop (etaf-desktop-create :canvas-width width
                                           :canvas-height height)))
        (unwind-protect
            (progn
              (etaf-desktop-set-setting desktop :tile-outer-gap 4)
              (etaf-desktop-set-setting desktop :tile-inner-gap 4)
              (dolist (id '(one two))
                (etaf-desktop-open-window desktop id :min-width minimum-width
                                          :min-height 8))
              (etaf-desktop-layout-split desktop 'one 'two orientation 0.5)
              (let ((one (etaf-desktop-window-state desktop 'one))
                    (two (etaf-desktop-window-state desktop 'two)))
                (dolist (window (list one two))
                  (should (= minimum-width (plist-get window :width)))
                  (should (= 8 (plist-get window :height))))
                (should (= (/ slack 2) (plist-get one :x) (plist-get one :y)))
                (should (= (- width (/ slack 2))
                           (+ (plist-get two :x) (plist-get two :width))))
                (should (= (- height (/ slack 2))
                           (+ (plist-get two :y) (plist-get two :height))))
                (should (= 4 (plist-get (etaf-desktop-settings desktop)
                                        :tile-outer-gap)))))
          (etaf-desktop-close desktop))))))

(ert-deftest etaf-desktop-tile-spacing-monocle-preserves-outer-gap ()
  "Monocle margins depend on visible pane minimums, not the retained split sum."
  (let* ((cell (frame-char-width))
         (desktop (etaf-desktop-create :canvas-width (* 100 cell)
                                       :canvas-height 24)))
    (unwind-protect
        (progn
          (dolist (id '(one two))
            (etaf-desktop-open-window desktop id :min-width 5 :min-height 12))
          (etaf-desktop-layout-split desktop 'one 'two 'vertical 0.5)
          (etaf-desktop-set-layout-mode desktop 'monocle)
          (dolist (inner '(1 4))
            (etaf-desktop-set-setting desktop :tile-inner-gap inner)
            (dolist (id '(one two))
              (should (equal (list cell 1 (* 98 cell) 22)
                             (etaf-desktop-test-spacing-rectangle desktop id))))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-preserves-maximum-size ()
  "Custom gaps leave constrained panes within their maximum size on both axes."
  (dolist (orientation '(horizontal vertical))
    (let* ((cell (frame-char-width))
           (horizontal (eq orientation 'horizontal))
           (desktop (etaf-desktop-create :canvas-width (* 100 cell)
                                         :canvas-height 32)))
      (unwind-protect
          (progn
            (etaf-desktop-set-setting desktop :tile-outer-gap 2)
            (etaf-desktop-set-setting desktop :tile-inner-gap 3)
            (etaf-desktop-open-window desktop 'one :min-width 5 :min-height 2
                                      :max-width (and horizontal (* 20 cell))
                                      :max-height (and (not horizontal) 7))
            (etaf-desktop-open-window desktop 'two :min-width 5 :min-height 2)
            (etaf-desktop-layout-split desktop 'one 'two orientation 0.95)
            (dolist (inner '(3 4))
              (etaf-desktop-set-setting desktop :tile-inner-gap inner)
              (let ((one (etaf-desktop-window-state desktop 'one))
                    (two (etaf-desktop-window-state desktop 'two)))
                (if horizontal
                    (progn
                      (should (= (* 20 cell) (plist-get one :width)))
                      (should (= (max 3 (* inner cell))
                                 (- (plist-get two :x)
                                    (+ (plist-get one :x) (plist-get one :width)))))
                      (should (= (* 98 cell)
                                 (+ (plist-get two :x) (plist-get two :width)))))
                  (should (= 7 (plist-get one :height)))
                  (should (= inner (- (plist-get two :y)
                                      (+ (plist-get one :y)
                                         (plist-get one :height)))))
                  (should (= 30 (+ (plist-get two :y)
                                   (plist-get two :height))))))))
        (etaf-desktop-close desktop)))))

(ert-deftest etaf-desktop-tile-spacing-small-canvas-keeps-panes-inside ()
  "Compressed gaps keep nested panes positive, disjoint and inside the canvas."
  (dolist (orientation '(horizontal vertical))
    (dolist (ratio '(0.1 0.9))
      (let* ((horizontal (eq orientation 'horizontal))
             (width (if horizontal 3 (* 100 (frame-char-width))))
             (desktop (etaf-desktop-create :canvas-width width :canvas-height 8)))
        (unwind-protect
            (progn
              (etaf-desktop-set-setting desktop :tile-outer-gap 4)
              (etaf-desktop-set-setting desktop :tile-inner-gap 4)
              (dolist (id '(one two three))
                (etaf-desktop-open-window desktop id :min-width 1 :min-height 1))
              (etaf-desktop-set-layout-mode desktop 'tiling)
              (etaf-desktop-layout-set-tree
               desktop (list :split orientation ratio '(:leaf one)
                             (list :split orientation 0.5
                                   '(:leaf two) '(:leaf three))))
              (let ((windows (mapcar (lambda (id)
                                      (etaf-desktop-window-state desktop id))
                                    '(one two three)))
                    (previous-end 0))
                (dolist (window windows)
                  (should (> (plist-get window :width) 0))
                  (should (> (plist-get window :height) 0))
                  (should (<= 0 (plist-get window :x)))
                  (should (<= 0 (plist-get window :y)))
                  (should (<= (+ (plist-get window :x) (plist-get window :width))
                              width))
                  (should (<= (+ (plist-get window :y) (plist-get window :height))
                              8))
                  (let ((start (plist-get window (if horizontal :x :y)))
                        (size (plist-get window (if horizontal :width :height))))
                    (should (<= previous-end start))
                    (setq previous-end (+ start size)))))
              (should (= 4 (plist-get (etaf-desktop-settings desktop)
                                      :tile-inner-gap))))
          (etaf-desktop-close desktop))))))

(ert-deftest etaf-desktop-tile-spacing-applies-on-workspace-switch ()
  "Inactive workspaces retain their geometry until selected with current gaps."
  (let* ((cell (frame-char-width))
         (desktop (etaf-desktop-create :canvas-width (* 100 cell)
                                       :canvas-height 24 :workspaces '(main dev))))
    (unwind-protect
        (progn
          (etaf-desktop-open-window desktop 'main :min-width 5 :min-height 2)
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (etaf-desktop-switch-workspace desktop 'dev)
          (etaf-desktop-open-window desktop 'dev :min-width 5 :min-height 2)
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (let ((before (etaf-desktop-test-spacing-rectangle desktop 'dev))
                (tree (etaf-desktop-layout-tree desktop 'dev)))
            (etaf-desktop-switch-workspace desktop 'main)
            (etaf-desktop-set-setting desktop :tile-outer-gap 3)
            (etaf-desktop-set-setting desktop :tile-inner-gap 4)
            (should (equal before (etaf-desktop-test-spacing-rectangle desktop 'dev)))
            (should (equal (list (* 3 cell) 3 (* 94 cell) 18)
                           (etaf-desktop-test-spacing-rectangle desktop 'main)))
            (etaf-desktop-switch-workspace desktop 'dev)
            (should (equal (list (* 3 cell) 3 (* 94 cell) 18)
                           (etaf-desktop-test-spacing-rectangle desktop 'dev)))
            (should (equal tree (etaf-desktop-layout-tree desktop 'dev)))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-keeps-maximized-window-full-size ()
  "Gap changes preserve maximization and restore into the current tile spacing."
  (let* ((cell (frame-char-width))
         (desktop (etaf-desktop-create :canvas-width (* 100 cell)
                                       :canvas-height 24)))
    (unwind-protect
        (progn
          (dolist (id '(one two))
            (etaf-desktop-open-window desktop id :min-width 5 :min-height 2))
          (etaf-desktop-layout-split desktop 'one 'two 'vertical 0.5)
          (let ((tree (etaf-desktop-layout-tree desktop)))
            (etaf-desktop-maximize-window desktop 'one)
            (etaf-desktop-set-setting desktop :tile-outer-gap 3)
            (etaf-desktop-set-setting desktop :tile-inner-gap 4)
            (should (etaf-desktop-window-maximized-p desktop 'one))
            (should (equal (list 0 0 (* 100 cell) 24)
                           (etaf-desktop-test-spacing-rectangle desktop 'one)))
            (etaf-desktop-restore-window desktop 'one)
            (should (equal (list (* 3 cell) 3 (* 94 cell) 7)
                           (etaf-desktop-test-spacing-rectangle desktop 'one)))
            (should (equal (list (* 3 cell) 14 (* 94 cell) 7)
                           (etaf-desktop-test-spacing-rectangle desktop 'two)))
            (should (equal tree (etaf-desktop-layout-tree desktop)))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-settings-controls-reflow-live-tiles ()
  "The settings tabs edit live tile gaps, retain values and expose reset/close."
  (let* ((cell (frame-char-width))
         (desktop (etaf-desktop-create :name " *desktop-spacing-settings*"
                                       :canvas-width (* 100 cell)
                                       :canvas-height 32)))
    (unwind-protect
        (progn
          (dolist (id '(one two))
            (etaf-desktop-open-window desktop id :min-width 5 :min-height 2))
          (etaf-desktop-layout-split desktop 'one 'two 'vertical 0.5)
          (let* ((buffer (etaf-desktop-mount desktop))
                 (runtime (etaf-runtime-for-buffer buffer)))
            (etaf-desktop-toggle-settings desktop t)
            (etaf-desktop-test-spacing-press runtime "Layout")
            (cl-letf (((symbol-function 'read-number) (lambda (&rest _) 0)))
              (etaf-desktop-test-spacing-press runtime "Outer gap"))
            (cl-letf (((symbol-function 'read-number) (lambda (&rest _) 3)))
              (etaf-desktop-test-spacing-press runtime "Inner gap"))
            (should (= 0 (plist-get (etaf-desktop-settings desktop) :tile-outer-gap)))
            (should (= 3 (plist-get (etaf-desktop-settings desktop) :tile-inner-gap)))
            (let ((one (etaf-desktop-window-state desktop 'one))
                  (two (etaf-desktop-window-state desktop 'two)))
              (should (= 0 (plist-get one :x) (plist-get one :y)))
              (should (= 3 (- (plist-get two :y) (plist-get one :height)))))
            (etaf-desktop-test-spacing-press runtime "Appearance")
            (etaf-desktop-test-spacing-press runtime "Layout")
            (with-current-buffer buffer
              (should (string-match-p "Outer gap 0" (buffer-string)))
              (should (string-match-p "Inner gap 3" (buffer-string))))
            (etaf-desktop-test-spacing-press runtime "Reset settings")
            (should (= 1 (plist-get (etaf-desktop-settings desktop) :tile-outer-gap)))
            (should (= 1 (plist-get (etaf-desktop-settings desktop) :tile-inner-gap)))
            (should (eq 'floating (etaf-desktop-layout-mode desktop)))
            (etaf-desktop-test-spacing-press runtime "Done")
            (should-not (etaf-desktop-settings-open-p desktop))))
      (etaf-desktop-close desktop))))

(ert-deftest etaf-desktop-tile-spacing-session-roundtrip ()
  "Saved sessions restore gap preferences and geometry with their split tree."
  (let* ((width (* 100 (frame-char-width)))
         (desktop (etaf-desktop-create :canvas-width width :canvas-height 32))
         (restored (etaf-desktop-create :canvas-width width :canvas-height 32))
         (file (make-temp-file "etaf-desktop-spacing-" nil ".el")))
    (unwind-protect
        (progn
          (etaf-desktop-set-setting desktop :tile-outer-gap 2)
          (etaf-desktop-set-setting desktop :tile-inner-gap 3)
          (dolist (id '(one two three overlay))
            (etaf-desktop-open-window desktop id :min-width 5 :min-height 2))
          (etaf-desktop-set-layout-mode desktop 'tiling)
          (etaf-desktop-layout-set-tree
           desktop '(:split horizontal 0.65 (:leaf one)
                            (:split vertical 0.4 (:leaf two) (:leaf three))))
          (let* ((session (etaf-desktop-session-state desktop))
                 (settings (plist-get (plist-get session :desktop) :settings)))
            (should (= 2 (plist-get settings :tile-outer-gap)))
            (should (= 3 (plist-get settings :tile-inner-gap))))
          (etaf-desktop-save-session desktop file)
          (etaf-desktop-set-setting restored :tile-outer-gap 0)
          (etaf-desktop-set-setting restored :tile-inner-gap 4)
          (etaf-desktop-restore-session restored file)
          (should (= 2 (plist-get (etaf-desktop-settings restored) :tile-outer-gap)))
          (should (= 3 (plist-get (etaf-desktop-settings restored) :tile-inner-gap)))
          (should (eq 'tiling (etaf-desktop-layout-mode restored)))
          (should (equal (etaf-desktop-layout-tree desktop)
                         (etaf-desktop-layout-tree restored)))
          (should (equal '(overlay) (etaf-desktop-layout-floating-windows restored)))
          (dolist (id '(one two three overlay))
            (ert-info ((format "Restored window: %S" id))
              (should (equal (etaf-desktop-test-spacing-rectangle desktop id)
                             (etaf-desktop-test-spacing-rectangle restored id))))))
      (delete-file file)
      (etaf-desktop-close desktop)
      (etaf-desktop-close restored))))

(ert-deftest etaf-desktop-tile-spacing-session-rejects-invalid-gaps ()
  "Session restore validates persisted spacing through the public setting rules."
  (dolist (setting '((:tile-outer-gap . -1) (:tile-outer-gap . 5)
                    (:tile-inner-gap . 0) (:tile-inner-gap . 1.5)))
    (let ((desktop (etaf-desktop-create)))
      (unwind-protect
          (let* ((session (etaf-desktop-session-state desktop))
                 (settings (plist-get (plist-get session :desktop) :settings)))
            (setf (plist-get settings (car setting)) (cdr setting))
            (should-error (etaf-desktop-restore-session desktop session)
                          :type 'etaf-desktop-error)
            (should (= 1 (plist-get (etaf-desktop-settings desktop) (car setting)))))
        (etaf-desktop-close desktop)))))

(ert-deftest etaf-desktop-session-restores-fixed-floating-window ()
  "Session restore preserves fixed window geometry without requiring resize permission."
  (let ((source (etaf-desktop-create :canvas-width 100 :canvas-height 24))
        (target (etaf-desktop-create :canvas-width 100 :canvas-height 24)))
    (unwind-protect
        (progn
          (etaf-desktop-open-window source 'fixed :x 7 :y 4 :width 23 :height 6
                                    :min-width 5 :min-height 2
                                    :movable nil :resizable nil)
          (etaf-desktop-open-window source 'other :min-width 5 :min-height 2)
          (etaf-desktop-restore-session target (etaf-desktop-session-state source))
          (let ((fixed (etaf-desktop-window-state target 'fixed)))
            (should-not (plist-get fixed :resizable))
            (should-not (plist-get fixed :movable)))
          (should (= 2 (length (etaf-desktop-windows target))))
          (should (equal (etaf-desktop-test-spacing-rectangle source 'fixed)
                         (etaf-desktop-test-spacing-rectangle target 'fixed)))
          (should (eq 'floating (etaf-desktop-layout-mode target))))
      (etaf-desktop-close source)
      (etaf-desktop-close target))))

(ert-deftest etaf-desktop-session-restores-floating-geometry-with-retained-tree ()
  "Returning to floating mode preserves manually edited rectangles across restore."
  (let* ((cell (frame-char-width))
         (source (etaf-desktop-create :canvas-width (* 100 cell) :canvas-height 24))
         (target (etaf-desktop-create :canvas-width (* 100 cell) :canvas-height 24)))
    (unwind-protect
        (progn
          (etaf-desktop-set-setting source :tile-outer-gap 2)
          (etaf-desktop-set-setting source :tile-inner-gap 3)
          (dolist (id '(one two))
            (etaf-desktop-open-window source id :min-width 5 :min-height 2))
          (etaf-desktop-set-setting source :layout-mode 'tiling)
          (etaf-desktop-toggle-layout-mode source)
          (etaf-desktop-move-window source 'one 7 4)
          (etaf-desktop-resize-window source 'one (* 23 cell) 6)
          (should (etaf-desktop-layout-tree source))
          (should-not (etaf-desktop-layout-floating-windows source))
          (etaf-desktop-restore-session target (etaf-desktop-session-state source))
          (should (eq 'floating (etaf-desktop-layout-mode target)))
          (should (equal (etaf-desktop-layout-tree source)
                         (etaf-desktop-layout-tree target)))
          (dolist (id '(one two))
            (should (equal (etaf-desktop-test-spacing-rectangle source id)
                           (etaf-desktop-test-spacing-rectangle target id)))))
      (etaf-desktop-close source)
      (etaf-desktop-close target))))

(ert-deftest etaf-desktop-session-retains-panes-smaller-than-minimums ()
  "A small-canvas session keeps tiles whose allocated sizes are below their limits."
  (let ((source (etaf-desktop-create :canvas-width 100 :canvas-height 8))
        (target (etaf-desktop-create :canvas-width 100 :canvas-height 8)))
    (unwind-protect
        (progn
          (etaf-desktop-set-setting source :tile-outer-gap 4)
          (etaf-desktop-set-setting source :tile-inner-gap 4)
          (dolist (id '(one two))
            (etaf-desktop-open-window source id :min-width 5 :min-height 6))
          (etaf-desktop-set-layout-mode source 'tiling)
          (dolist (id '(one two))
            (should (< (plist-get (etaf-desktop-window-state source id) :height) 6)))
          (etaf-desktop-restore-session target (etaf-desktop-session-state source))
          (should (= 2 (length (etaf-desktop-windows target))))
          (should (eq 'tiling (etaf-desktop-layout-mode target)))
          (should (equal (etaf-desktop-layout-tree source)
                         (etaf-desktop-layout-tree target)))
          (dolist (id '(one two))
            (should (= 6 (plist-get (etaf-desktop-window-state target id)
                                    :min-height)))
            (should (equal (etaf-desktop-test-spacing-rectangle source id)
                           (etaf-desktop-test-spacing-rectangle target id)))))
      (etaf-desktop-close source)
      (etaf-desktop-close target))))

(provide 'etaf-desktop-spacing-tests)
